axes.prop_cycle: cycler(color=['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'], linestyle=['-', '--', '-.', ':', '-', '--', '-.'])
figure.figsize: 1.6, 1.2
figure.dpi: 300

xtick.direction: in
xtick.major.size: 2
xtick.major.width: 0.4
xtick.minor.size: 1.0
xtick.minor.width: 0.4
xtick.minor.visible: True
xtick.top: True

ytick.direction: in
ytick.major.size: 2
ytick.major.width: 0.4
ytick.minor.size: 1.0
ytick.minor.width: 0.4
ytick.minor.visible: True
ytick.right: True

axes.linewidth: 0.4
grid.linewidth: 0.4
lines.linewidth: 0.8

axes.grid: True
axes.axisbelow: True
axes.facecolor: white
axes.edgecolor: black
grid.linestyle: --
grid.color: k
grid.alpha: 0.5

legend.frameon: True
legend.framealpha: 1.0
legend.fancybox: True
legend.numpoints: 1

# Tighter legend settings
legend.borderpad: 0.2
legend.labelspacing: 0.2
legend.handlelength: 1.0
legend.handletextpad: 0.2
legend.borderaxespad: 0.2
legend.columnspacing: 0.5

savefig.bbox: tight
savefig.pad_inches: 0.02

font.size: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 5
legend.title_fontsize: 6
axes.titlesize: 7
axes.labelsize: 7
font.family: serif
font.serif: Times New Roman
mathtext.fontset: dejavuserif
